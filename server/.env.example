PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lumify
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Optional: Email Service for Shared Budgets (Nodemailer SMTP)
# In development without SMTP configured, invitations log to console with clean in-app notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@lumify.app
